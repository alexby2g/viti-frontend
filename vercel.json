{
  "buildCommand": "node scripts/build-sensaciones-preview.mjs",
  "outputDirectory": "dist/spa",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/sensaciones-qa-unavailable.json"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "/sensaciones-qa-unavailable.json"
    },
    {
      "source": "/auth/google/:path*",
      "destination": "/sensaciones-qa-unavailable.json"
    },
    {
      "source": "/storage/:path*",
      "destination": "/sensaciones-qa-unavailable.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
