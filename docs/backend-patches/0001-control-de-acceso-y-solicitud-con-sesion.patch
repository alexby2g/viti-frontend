@@ -0,0 +1,36 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+class AplicacionDominio extends Model
+{
+    protected $table = 'aplicacion_dominios';
+
+    protected $fillable = ['aplicacion_id', 'dominio', 'tipo', 'activo', 'ultima_consulta_at', 'notas'];
+
+    protected $casts = ['activo' => 'boolean', 'ultima_consulta_at' => 'datetime'];
+
+    public function aplicacion()
+    {
+        return $this->belongsTo(Aplicacion::class);
+    }
+
+    /**
+     * Normaliza cualquier entrada ("https://www.MiNegocio.com/panel", "minegocio.com")
+     * al host que se guarda y se consulta: "minegocio.com".
+     */
+    public static function normalize(?string $value): ?string
+    {
+        $value = trim((string) $value);
+        if ($value === '') return null;
+        if (!preg_match('#^[a-z][a-z0-9+.-]*://#i', $value)) $value = 'https://'.$value;
+        $host = strtolower((string) parse_url($value, PHP_URL_HOST));
+        $host = preg_replace('/^www\./', '', $host);
+        $host = rtrim((string) $host, '.');
+        if ($host === '' || strlen($host) > 190) return null;
+        $validHost = filter_var($host, FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME) !== false;
+        return $validHost ? $host : null;
+    }
+}
diff --git a/app/Services/AppAccessService.php b/app/Services/AppAccessService.php
new file mode 100644
index 0000000..5c4d89a
--- /dev/null
+++ b/app/Services/AppAccessService.php
@@ -0,0 +1,127 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Aplicacion;
+use Illuminate\Support\Carbon;
+
+/**
+ * Decide, en un solo lugar, si un sistema entregado puede usarse ahora.
+ *
+ * Orden de prioridad (el primero que aplica gana):
+ *  1. retirado          -> el sistema ya no opera.
+ *  2. bloqueado_manual  -> VITI bloqueó el acceso a mano (motivo libre).
+ *  3. pausado           -> ciclo operativo pausado.
+ *  4. no_entregado      -> todavía no está en producción/entregado al cliente.
+ *  5. bloqueado_pago    -> el plan exige pago y la suscripción está suspendida.
+ *  6. mantenimiento     -> deshabilitado temporalmente por una actualización.
+ *  7. gracia            -> pago vencido, pero todavía dentro de los días de gracia (permitido).
+ *  8. activo            -> todo en orden.
+ */
+class AppAccessService
+{
+    public const STATES = ['activo', 'gracia', 'mantenimiento', 'bloqueado_pago', 'bloqueado_manual', 'pausado', 'no_entregado', 'retirado'];
+
+    public function __construct(private SubscriptionAccessService $subscriptions) {}
+
+    public function evaluate(Aplicacion $app): array
+    {
+        $this->expireMaintenance($app);
+
+        $config = is_array($app->configuracion) ? $app->configuracion : [];
+        $license = is_array($config['license'] ?? null) ? $config['license'] : [];
+        $paymentControl = ($license['payment_required'] ?? true) !== false;
+        $subscription = $this->subscriptions->statusFor($app);
+
+        $base = [
+            'control_pago' => $paymentControl,
+            'suscripcion' => $subscription,
+            'mantenimiento' => [
+                'activo' => (bool) $app->mantenimiento_activo,
+                'mensaje' => $app->mantenimiento_mensaje,
+                'hasta' => $app->mantenimiento_hasta?->toIso8601String(),
+            ],
+            'bloqueo_manual' => [
+                'activo' => (bool) $app->bloqueo_manual,
+                'motivo' => $app->bloqueo_motivo,
+            ],
+            'aviso' => null,
+        ];
+
+        if ($app->estado === 'retirado') {
+            return $this->result($base, 'retirado', false, 'Sistema retirado', 'Este sistema fue retirado y ya no está disponible.');
+        }
+
+        if ($app->bloqueo_manual) {
+            return $this->result($base, 'bloqueado_manual', false, 'Acceso suspendido',
+                trim((string) $app->bloqueo_motivo) ?: 'VITI suspendió temporalmente el acceso a este sistema. Comunícate con Atención VITI.');
+        }
+
+        if ($app->estado === 'pausado') {
+            return $this->result($base, 'pausado', false, 'Sistema pausado', 'El sistema está pausado temporalmente por VITI.');
+        }
+
+        $delivered = $app->entorno === 'produccion' && $app->estado === 'activo' && (bool) $app->acceso_cliente;
+        if (!$delivered) {
+            return $this->result($base, 'no_entregado', false, 'Aún no disponible', 'El sistema todavía está en preparación y no fue entregado.');
+        }
+
+        if ($paymentControl && $subscription && !$subscription['puede_usar']) {
+            return $this->result($base, 'bloqueado_pago', false, 'Servicio suspendido por falta de pago',
+                'La suscripción de este sistema está vencida. Regulariza el pago en VITI para volver a habilitar el acceso.');
+        }
+
+        if ($app->mantenimiento_activo) {
+            $until = $app->mantenimiento_hasta;
+            $message = trim((string) $app->mantenimiento_mensaje)
+                ?: 'Estamos actualizando este sistema para mejorarlo. Vuelve a intentarlo en unos minutos.';
+            return $this->result($base, 'mantenimiento', false, 'En mantenimiento', $message, $until);
+        }
+
+        if ($paymentControl && $subscription && ($subscription['estado'] ?? null) === 'gracia') {
+            $base['aviso'] = $subscription['mensaje_cobro'] ?? 'Pago pendiente dentro del periodo de gracia.';
+            return $this->result($base, 'gracia', true, 'Pago pendiente', 'El sistema sigue activo dentro del periodo de gracia.', null);
+        }
+
+        if ($paymentControl && $subscription && ($subscription['etapa_cobro'] ?? null) === 'por_vencer') {
+            $base['aviso'] = $subscription['mensaje_cobro'] ?? null;
+        }
+
+        return $this->result($base, 'activo', true, 'Activo', 'Sistema activo.');
+    }
+
+    /**
+     * Payload para respuestas HTTP que bloquean el uso de un sistema.
+     */
+    public static function httpStatusFor(string $state): int
+    {
+        return match ($state) {
+            'bloqueado_pago' => 402,
+            'mantenimiento' => 503,
+            'bloqueado_manual' => 423,
+            default => 403,
+        };
+    }
+
+    /**
+     * Un mantenimiento programado con fecha de fin se desactiva solo cuando esa fecha pasa.
+     */
+    public function expireMaintenance(Aplicacion $app): void
+    {
+        if (!$app->mantenimiento_activo || !$app->mantenimiento_hasta) return;
+        if ($app->mantenimiento_hasta->isFuture()) return;
+
+        $app->forceFill(['mantenimiento_activo' => false, 'mantenimiento_hasta' => null])->saveQuietly();
+    }
+
+    private function result(array $base, string $state, bool $allowed, string $title, string $message, ?Carbon $until = null): array
+    {
+        return $base + [
+            'estado' => $state,
+            'permitido' => $allowed,
+            'titulo' => $title,
+            'mensaje' => $message,
+            'hasta' => $until?->toIso8601String(),
+        ];
+    }
+}
