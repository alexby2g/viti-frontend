new file mode 100644
index 0000000..953ff0a
--- /dev/null
+++ b/app/Http/Middleware/OpenPublicAccessCheckCors.php
@@ -0,0 +1,29 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * La consulta pública de acceso por dominio (GET /api/v1/publico/acceso) la hacen
+ * los sistemas entregados desde sus propios dominios. Debe responder a cualquier
+ * origen, sin cookies. Se registra antes de HandleCors para tener la última palabra.
+ */
+class OpenPublicAccessCheckCors
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $response = $next($request);
+
+        if ($request->is('api/v1/publico/acceso')) {
+            $response->headers->set('Access-Control-Allow-Origin', '*');
+            $response->headers->set('Access-Control-Allow-Methods', 'GET, OPTIONS');
+            $response->headers->remove('Access-Control-Allow-Credentials');
+            $response->headers->set('Vary', 'Origin');
+        }
+
+        return $response;
+    }
+}
