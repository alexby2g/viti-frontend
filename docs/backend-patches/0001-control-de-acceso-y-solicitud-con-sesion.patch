diff --git a/tests/Feature/AppAccessControlTest.php b/tests/Feature/AppAccessControlTest.php
new file mode 100644
index 0000000..ed0a341
--- /dev/null
+++ b/tests/Feature/AppAccessControlTest.php
@@ -0,0 +1,246 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\{AplicacionDominio, Suscripcion, Usuario};
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Tests\{CreatesVitiTenants, TestCase};
+
+class AppAccessControlTest extends TestCase
+{
+    use CreatesVitiTenants, RefreshDatabase;
+
+    protected function tearDown(): void
+    {
+        Carbon::setTestNow();
+        parent::tearDown();
+    }
+
+    public function test_admin_registers_normalized_domain_and_it_cannot_be_reused_by_another_system(): void
+    {
+        $admin = $this->admin();
+        $a = $this->createTenant('DOM-A');
+        $b = $this->createTenant('DOM-B');
+
+        $this->actingAs($admin)->postJson("/api/v1/aplicaciones/{$a['app']->id}/dominios", ['dominio' => 'https://www.MiNegocio.com/panel?x=1'])
+            ->assertCreated()
+            ->assertJsonPath('data.dominio', 'minegocio.com')
+            ->assertJsonPath('data.tipo', 'principal');
+
+        // Registrar de nuevo el mismo dominio no lo degrada a alias.
+        $this->actingAs($admin)->postJson("/api/v1/aplicaciones/{$a['app']->id}/dominios", ['dominio' => 'minegocio.com'])
+            ->assertOk()
+            ->assertJsonPath('data.tipo', 'principal');
+
+        $this->actingAs($admin)->postJson("/api/v1/aplicaciones/{$b['app']->id}/dominios", ['dominio' => 'minegocio.com'])
+            ->assertStatus(422)
+            ->assertJsonPath('message', 'El dominio minegocio.com ya está asignado a otro sistema.');
+
+        $this->actingAs($admin)->postJson("/api/v1/aplicaciones/{$a['app']->id}/dominios", ['dominio' => 'no es un dominio'])
+            ->assertStatus(422);
+
+        $this->assertDatabaseHas('aplicacion_dominios', ['aplicacion_id' => $a['app']->id, 'dominio' => 'minegocio.com']);
+        $this->assertDatabaseHas('auditoria', ['accion' => 'dominio_registrado']);
+    }
+
+    public function test_updating_system_url_registers_its_domain_automatically(): void
+    {
+        $admin = $this->admin();
+        $t = $this->createTenant('AUTO-URL');
+
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}", [
+            'empresa_id' => $t['company']->id,
+            'nombre' => $t['app']->nombre,
+            'url' => 'https://reservas.cliente-demo.com/app',
+            'url_administracion' => 'https://admin.cliente-demo.com',
+        ])->assertOk();
+
+        $this->assertDatabaseHas('aplicacion_dominios', ['aplicacion_id' => $t['app']->id, 'dominio' => 'reservas.cliente-demo.com', 'tipo' => 'principal']);
+        $this->assertDatabaseHas('aplicacion_dominios', ['aplicacion_id' => $t['app']->id, 'dominio' => 'admin.cliente-demo.com', 'tipo' => 'administracion']);
+    }
+
+    public function test_public_check_ignores_unmanaged_domains_and_allows_active_systems_from_any_origin(): void
+    {
+        $t = $this->createTenant('PUBLIC-OK');
+        AplicacionDominio::create(['aplicacion_id' => $t['app']->id, 'dominio' => 'activo.example.com', 'tipo' => 'principal']);
+
+        $this->getJson('/api/v1/publico/acceso?dominio=desconocido.example.com')
+            ->assertStatus(404)
+            ->assertJsonPath('gestionado', false)
+            ->assertJsonPath('permitido', true);
+
+        $response = $this->getJson('/api/v1/publico/acceso?dominio=https://www.activo.example.com/ruta', ['Origin' => 'https://activo.example.com'])
+            ->assertOk()
+            ->assertJsonPath('gestionado', true)
+            ->assertJsonPath('permitido', true)
+            ->assertJsonPath('estado', 'activo');
+
+        $this->assertSame('*', $response->headers->get('Access-Control-Allow-Origin'));
+        $this->assertNull($response->headers->get('Access-Control-Allow-Credentials'));
+        $this->assertArrayNotHasKey('empresa', $response->json());
+
+        // Sin parámetro, se usa el Origin del sistema que consulta.
+        $this->getJson('/api/v1/publico/acceso', ['Origin' => 'https://activo.example.com'])
+            ->assertOk()->assertJsonPath('dominio', 'activo.example.com');
+    }
+
+    public function test_unpaid_subscription_blocks_domain_and_internal_app_until_payment_control_is_disabled(): void
+    {
+        Carbon::setTestNow('2026-09-24 10:00:00');
+        $admin = $this->admin();
+        $t = $this->createTenant('UNPAID');
+        AplicacionDominio::create(['aplicacion_id' => $t['app']->id, 'dominio' => 'moroso.example.com']);
+        $this->subscription($t, '2026-09-01', 3);
+
+        $this->getJson('/api/v1/publico/acceso?dominio=moroso.example.com')
+            ->assertOk()
+            ->assertJsonPath('permitido', false)
+            ->assertJsonPath('estado', 'bloqueado_pago');
+
+        $this->actingAs($t['user'])->getJson('/api/v1/mi/apps/electrofrio/resumen', $this->tenantHeaders($t))
+            ->assertStatus(402)
+            ->assertJsonPath('bloqueo.estado', 'bloqueado_pago');
+
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}/politica-acceso", ['control_pago' => false])
+            ->assertOk()
+            ->assertJsonPath('data.acceso.estado', 'activo')
+            ->assertJsonPath('data.acceso.control_pago', false);
+
+        $this->getJson('/api/v1/publico/acceso?dominio=moroso.example.com')
+            ->assertOk()->assertJsonPath('permitido', true);
+    }
+
+    public function test_grace_period_keeps_access_with_a_warning(): void
+    {
+        Carbon::setTestNow('2026-09-24 10:00:00');
+        $t = $this->createTenant('GRACE');
+        AplicacionDominio::create(['aplicacion_id' => $t['app']->id, 'dominio' => 'gracia.example.com']);
+        $this->subscription($t, '2026-09-22', 5);
+
+        $response = $this->getJson('/api/v1/publico/acceso?dominio=gracia.example.com')
+            ->assertOk()
+            ->assertJsonPath('permitido', true)
+            ->assertJsonPath('estado', 'gracia');
+        $this->assertNotEmpty($response->json('aviso'));
+    }
+
+    public function test_maintenance_temporarily_disables_system_and_expires_automatically(): void
+    {
+        Carbon::setTestNow('2026-09-24 10:00:00');
+        $admin = $this->admin();
+        $t = $this->createTenant('MAINT');
+        AplicacionDominio::create(['aplicacion_id' => $t['app']->id, 'dominio' => 'mantenimiento.example.com']);
+
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}/mantenimiento", [
+            'activo' => true, 'mensaje' => 'Actualizando a la versión 2.0', 'hasta' => '2026-09-24 12:00:00',
+        ])->assertOk()->assertJsonPath('data.acceso.estado', 'mantenimiento');
+
+        $this->getJson('/api/v1/publico/acceso?dominio=mantenimiento.example.com')
+            ->assertOk()
+            ->assertJsonPath('permitido', false)
+            ->assertJsonPath('estado', 'mantenimiento')
+            ->assertJsonPath('mensaje', 'Actualizando a la versión 2.0');
+
+        $this->actingAs($t['user'])->getJson('/api/v1/mi/apps/electrofrio/resumen', $this->tenantHeaders($t))
+            ->assertStatus(503)
+            ->assertJsonPath('bloqueo.estado', 'mantenimiento')
+            ->assertJsonPath('message', 'Actualizando a la versión 2.0');
+
+        $apps = $this->actingAs($t['user'])->getJson('/api/v1/mi/aplicaciones', $this->tenantHeaders($t))->assertOk();
+        $this->assertSame('mantenimiento', $apps->json('data.0.estado_servicio'));
+        $this->assertFalse($apps->json('data.0.puede_usar'));
+
+        // Pasada la hora indicada, el sistema vuelve solo.
+        Carbon::setTestNow('2026-09-24 12:01:00');
+        $this->getJson('/api/v1/publico/acceso?dominio=mantenimiento.example.com')
+            ->assertOk()->assertJsonPath('permitido', true)->assertJsonPath('estado', 'activo');
+        $this->assertDatabaseHas('aplicaciones', ['id' => $t['app']->id, 'mantenimiento_activo' => false]);
+    }
+
+    public function test_admin_can_finish_maintenance_manually_and_block_manually(): void
+    {
+        $admin = $this->admin();
+        $t = $this->createTenant('MANUAL');
+        AplicacionDominio::create(['aplicacion_id' => $t['app']->id, 'dominio' => 'manual.example.com']);
+
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}/mantenimiento", ['activo' => true])->assertOk();
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}/mantenimiento", ['activo' => false])
+            ->assertOk()->assertJsonPath('data.acceso.estado', 'activo');
+
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}/bloqueo", ['activo' => true, 'motivo' => 'Contrato en revisión'])
+            ->assertOk()->assertJsonPath('data.acceso.estado', 'bloqueado_manual');
+
+        $this->getJson('/api/v1/publico/acceso?dominio=manual.example.com')
+            ->assertOk()->assertJsonPath('permitido', false)->assertJsonPath('mensaje', 'Contrato en revisión');
+
+        $this->actingAs($t['user'])->getJson('/api/v1/mi/apps/electrofrio/resumen', $this->tenantHeaders($t))
+            ->assertStatus(423)->assertJsonPath('bloqueo.estado', 'bloqueado_manual');
+
+        $this->actingAs($admin)->putJson("/api/v1/aplicaciones/{$t['app']->id}/bloqueo", ['activo' => false])
+            ->assertOk()->assertJsonPath('data.acceso.estado', 'activo');
+
+        $this->assertDatabaseHas('auditoria', ['accion' => 'aplicacion_bloqueada']);
+        $this->assertDatabaseHas('auditoria', ['accion' => 'aplicacion_desbloqueada']);
+    }
+
+    public function test_access_panel_lists_systems_with_summary_and_filters(): void
+    {
