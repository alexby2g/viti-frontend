+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\{Aplicacion, AplicacionDominio};
+use App\Services\AppAccessService;
+use App\Support\Audit;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Validation\Rule;
+
+/**
+ * Panel "Dominios y acceso": un solo lugar para ver qué sistemas están activos,
+ * cuáles están bloqueados por pago, cuáles en mantenimiento y qué dominios controla VITI.
+ */
+class AppAccessController extends Controller
+{
+    public function index(Request $request, AppAccessService $access): JsonResponse
+    {
+        $query = Aplicacion::query()
+            ->with([
+                'empresa:id,nombre_comercial,plan_viti_id',
+                'empresa.planViti:id,codigo,nombre,precio_mensual,precio_anual',
+                'suscripcion',
+                'dominios',
+            ])
+            ->where('es_plantilla', false)
+            ->where('estado', '!=', 'retirado')
+            ->latest('id');
+
+        if ($request->filled('buscar')) {
+            $term = '%'.trim((string) $request->string('buscar')).'%';
+            $query->where(fn ($q) => $q->where('nombre', 'like', $term)
+                ->orWhereHas('empresa', fn ($e) => $e->where('nombre_comercial', 'like', $term))
+                ->orWhereHas('dominios', fn ($d) => $d->where('dominio', 'like', $term)));
+        }
+
+        $items = $query->get()->map(fn (Aplicacion $app) => $this->present($app, $access))->values();
+
+        $filter = (string) $request->query('estado', '');
+        $summary = collect(AppAccessService::STATES)->mapWithKeys(fn ($state) => [$state => $items->where('acceso.estado', $state)->count()]);
+
+        if ($filter !== '' && in_array($filter, AppAccessService::STATES, true)) {
+            $items = $items->where('acceso.estado', $filter)->values();
+        } elseif ($filter === 'bloqueados') {
+            $items = $items->whereIn('acceso.estado', ['bloqueado_pago', 'bloqueado_manual', 'mantenimiento'])->values();
+        }
+
+        return response()->json([
+            'data' => $items,
+            'resumen' => $summary->all() + [
+                'total' => $summary->sum(),
+                'dominios' => AplicacionDominio::query()->where('activo', true)->count(),
+            ],
+        ]);
+    }
+
+    public function storeDomain(Request $request, Aplicacion $aplicacion): JsonResponse
+    {
+        $data = $request->validate([
+            'dominio' => ['required', 'string', 'max:255'],
+            'tipo' => ['nullable', Rule::in(['principal', 'alias', 'administracion', 'api'])],
+            'notas' => ['nullable', 'string', 'max:255'],
+        ]);
+
+        $host = AplicacionDominio::normalize($data['dominio']);
+        abort_unless($host, 422, 'Escribe un dominio o URL válido. Ejemplo: minegocio.com');
+
+        $existing = AplicacionDominio::query()->where('dominio', $host)->first();
+        if ($existing && (int) $existing->aplicacion_id !== (int) $aplicacion->id) {
+            abort(422, "El dominio {$host} ya está asignado a otro sistema.");
+        }
+
+        $domain = AplicacionDominio::updateOrCreate(
+            ['dominio' => $host],
+            [
+                'aplicacion_id' => $aplicacion->id,
+                // Volver a registrar un dominio existente no debe cambiar su tipo ni borrar sus notas.
+                'tipo' => $data['tipo'] ?? $existing?->tipo ?? ($aplicacion->dominios()->exists() ? 'alias' : 'principal'),
+                'activo' => true,
+                'notas' => array_key_exists('notas', $data) ? $data['notas'] : $existing?->notas,
+            ]
+        );
+
+        Audit::log($request, 'dominio_registrado', $aplicacion, "Se registró el dominio {$host} para el sistema.", ['dominio' => $host]);
+
+        return response()->json(['message' => "Dominio {$host} registrado.", 'data' => $domain], $domain->wasRecentlyCreated ? 201 : 200);
+    }
+
+    public function updateDomain(Request $request, Aplicacion $aplicacion, AplicacionDominio $dominio): JsonResponse
+    {
+        abort_unless((int) $dominio->aplicacion_id === (int) $aplicacion->id, 404);
+        $data = $request->validate([
+            'activo' => ['sometimes', 'boolean'],
+            'tipo' => ['sometimes', Rule::in(['principal', 'alias', 'administracion', 'api'])],
+            'notas' => ['nullable', 'string', 'max:255'],
+        ]);
+        $dominio->update($data);
+        Audit::log($request, 'dominio_actualizado', $aplicacion, "Se actualizó el dominio {$dominio->dominio}.", ['dominio' => $dominio->dominio] + $data);
+
+        return response()->json(['message' => 'Dominio actualizado.', 'data' => $dominio->fresh()]);
+    }
+
+    public function destroyDomain(Request $request, Aplicacion $aplicacion, AplicacionDominio $dominio): JsonResponse
+    {
+        abort_unless((int) $dominio->aplicacion_id === (int) $aplicacion->id, 404);
+        $host = $dominio->dominio;
+        $dominio->delete();
+        Audit::log($request, 'dominio_eliminado', $aplicacion, "Se quitó el dominio {$host} del sistema.", ['dominio' => $host]);
+
+        return response()->json(['message' => "Dominio {$host} eliminado."]);
+    }
+
+    public function maintenance(Request $request, Aplicacion $aplicacion, AppAccessService $access): JsonResponse
+    {
+        $data = $request->validate([
+            'activo' => ['required', 'boolean'],
+            'mensaje' => ['nullable', 'string', 'max:500'],
+            'hasta' => ['nullable', 'date', 'after:now'],
+        ], [
+            'hasta.after' => 'La hora de finalización debe estar en el futuro.',
+        ]);
+
+        $active = (bool) $data['activo'];
+        $aplicacion->update([
+            'mantenimiento_activo' => $active,
+            'mantenimiento_mensaje' => $active ? ($data['mensaje'] ?? null) : null,
+            'mantenimiento_hasta' => $active ? ($data['hasta'] ?? null) : null,
+        ]);
+
+        Audit::log($request, $active ? 'aplicacion_mantenimiento_activado' : 'aplicacion_mantenimiento_finalizado', $aplicacion,
+            $active ? 'Se deshabilitó temporalmente el sistema por mantenimiento.' : 'Se finalizó el mantenimiento del sistema.',
+            ['hasta' => $data['hasta'] ?? null]);
+
+        return response()->json([
+            'message' => $active ? 'Sistema en mantenimiento. Los usuarios verán el aviso hasta que lo finalices.' : 'Mantenimiento finalizado. El sistema vuelve a estar disponible.',
+            'data' => $this->present($aplicacion->fresh(['empresa.planViti', 'suscripcion', 'dominios']), $access),
+        ]);
+    }
+
+    public function block(Request $request, Aplicacion $aplicacion, AppAccessService $access): JsonResponse
+    {
+        $data = $request->validate([
+            'activo' => ['required', 'boolean'],
+            'motivo' => ['nullable', 'string', 'max:500'],
+        ]);
+
+        $active = (bool) $data['activo'];
+        $aplicacion->update([
+            'bloqueo_manual' => $active,
+            'bloqueo_motivo' => $active ? ($data['motivo'] ?? null) : null,
+        ]);
+
+        Audit::log($request, $active ? 'aplicacion_bloqueada' : 'aplicacion_desbloqueada', $aplicacion,
+            $active ? 'Se bloqueó manualmente el acceso al sistema.' : 'Se retiró el bloqueo manual del sistema.');
+
+        return response()->json([
+            'message' => $active ? 'Acceso bloqueado.' : 'Bloqueo retirado.',
+            'data' => $this->present($aplicacion->fresh(['empresa.planViti', 'suscripcion', 'dominios']), $access),
+        ]);
+    }
+
+    public function policy(Request $request, Aplicacion $aplicacion, AppAccessService $access): JsonResponse
+    {
+        $data = $request->validate([
+            'control_pago' => ['required', 'boolean'],
+        ]);
+
+        $config = is_array($aplicacion->configuracion) ? $aplicacion->configuracion : [];
+        $license = is_array($config['license'] ?? null) ? $config['license'] : [];
+        $license['payment_required'] = (bool) $data['control_pago'];
+        $config['license'] = $license;
+        $aplicacion->update(['configuracion' => $config]);
+
+        Audit::log($request, 'aplicacion_politica_acceso', $aplicacion,
+            $data['control_pago'] ? 'El acceso del sistema vuelve a depender del pago del plan.' : 'El acceso del sistema dejó de depender del pago.');
+
+        return response()->json([
+            'message' => $data['control_pago'] ? 'Bloqueo automático por falta de pago activado.' : 'Bloqueo automático por falta de pago desactivado.',
+            'data' => $this->present($aplicacion->fresh(['empresa.planViti', 'suscripcion', 'dominios']), $access),
+        ]);
+    }
+
+    /**
+     * Consulta pública usada por los sistemas entregados (script viti-guard.js o su servidor)
+     * para saber si deben mostrarse o bloquearse. No expone datos privados.
+     */
+    public function publicCheck(Request $request, AppAccessService $access): JsonResponse
+    {
+        $raw = $request->query('dominio') ?: $request->query('url') ?: $request->headers->get('Origin') ?: $request->headers->get('Referer');
+        $host = AplicacionDominio::normalize(is_string($raw) ? $raw : null);
+
+        $headers = ['Access-Control-Allow-Origin' => '*', 'Cache-Control' => 'no-store'];
+        if (!$host) {
+            return response()->json(['gestionado' => false, 'permitido' => true, 'message' => 'Indica el dominio a consultar.'], 422, $headers);
+        }
+
+        $domain = AplicacionDominio::query()->where('dominio', $host)->where('activo', true)
+            ->with(['aplicacion' => fn ($q) => $q->with('suscripcion')])
+            ->first();
+
+        if (!$domain || !$domain->aplicacion) {
+            // Un dominio no registrado no es administrado por VITI: no se bloquea.
+            return response()->json(['gestionado' => false, 'dominio' => $host, 'permitido' => true], 404, $headers);
+        }
+
+        $app = $domain->aplicacion;
+        $result = $access->evaluate($app);
+
+        if (!$domain->ultima_consulta_at || $domain->ultima_consulta_at->lt(now()->subMinutes(10))) {
+            $domain->forceFill(['ultima_consulta_at' => now()])->saveQuietly();
+        }
+
+        return response()->json([
+            'gestionado' => true,
+            'dominio' => $host,
+            'sistema' => $app->nombre,
+            'permitido' => $result['permitido'],
+            'estado' => $result['estado'],
+            'titulo' => $result['titulo'],
+            'mensaje' => $result['mensaje'],
+            'hasta' => $result['hasta'],
+            'aviso' => $result['aviso'],
+            'consultado_at' => now()->toIso8601String(),
+        ], 200, $headers);
+    }
+
+    private function present(Aplicacion $app, AppAccessService $access): array
+    {
+        $evaluation = $access->evaluate($app);
+        $plan = $app->empresa?->planViti;
+
+        return [
+            'id' => $app->id,
+            'nombre' => $app->nombre,
+            'slug' => $app->slug,
+            'url' => $app->url,
+            'url_administracion' => $app->url_administracion,
+            'entorno' => $app->entorno,
+            'estado' => $app->estado,
+            'acceso_cliente' => (bool) $app->acceso_cliente,
+            'entregado_at' => $app->entregado_at?->toIso8601String(),
+            'empresa' => $app->empresa ? ['id' => $app->empresa->id, 'nombre_comercial' => $app->empresa->nombre_comercial] : null,
+            'plan' => $plan ? ['codigo' => $plan->codigo, 'nombre' => $plan->nombre] : null,
+            'dominios' => $app->dominios->map(fn (AplicacionDominio $d) => [
+                'id' => $d->id,
+                'dominio' => $d->dominio,
+                'tipo' => $d->tipo,
+                'activo' => (bool) $d->activo,
+                'ultima_consulta_at' => $d->ultima_consulta_at?->toIso8601String(),
+            ])->values(),
+            'acceso' => $evaluation,
+        ];
+    }
+}
